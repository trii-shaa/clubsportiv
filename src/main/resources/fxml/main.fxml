<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" style="-fx-background-color: #11121d;" fx:controller="com.practica.controller.MainController">
    <top>
        <HBox style="-fx-background-color: rgba(41,36,62,0.9);
                     -fx-border-color: rgba(123,76,197,0.3);
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 14 24;"
              alignment="CENTER_LEFT" spacing="16">
            <Label text="🏋️" style="-fx-font-size: 22;"/>
            <Label text="Club Sportiv"
                   style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="lblWelcome"
                   style="-fx-text-fill: rgba(191,122,141,0.85); -fx-font-size: 13;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: rgba(191,122,141,0.18);
                           -fx-background-radius: 8; -fx-border-color: rgba(191,122,141,0.55);
                           -fx-border-radius: 8; -fx-border-width: 1;
                           -fx-text-fill: #bf7a8d; -fx-font-weight: bold;
                           -fx-cursor: hand; -fx-padding: 6 16;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="28" alignment="CENTER"
              style="-fx-padding: 50 40; -fx-background-color: #11121d;">
            <VBox spacing="4" alignment="CENTER">
                <Label text="Panou Administrator"
                       style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: white;
                              -fx-effect: dropshadow(gaussian, #7b4cc5, 16, 0.3, 0, 0);"/>
                <Label text="Selectează modulul dorit"
                       style="-fx-font-size: 13; -fx-text-fill: #bf7a8d;"/>
            </VBox>
            <GridPane hgap="16" vgap="16" alignment="CENTER">
                <Button text="👥  Membri" onAction="#deschideMembri"
                        prefWidth="200" prefHeight="90"
                        style="-fx-background-color: rgba(63,69,138,0.35); -fx-background-radius: 16;
                               -fx-border-color: rgba(63,69,138,0.8); -fx-border-radius: 16; -fx-border-width: 1.5;
                               -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(63,69,138,0.6), 16, 0, 0, 4);"
                        GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Button text="🏃  Antrenori" onAction="#deschideAntrenori"
                        prefWidth="200" prefHeight="90"
                        style="-fx-background-color: rgba(123,76,197,0.35); -fx-background-radius: 16;
                               -fx-border-color: rgba(123,76,197,0.8); -fx-border-radius: 16; -fx-border-width: 1.5;
                               -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(123,76,197,0.6), 16, 0, 0, 4);"
                        GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Button text="📅  Sedinte" onAction="#deschideSedinte"
                        prefWidth="200" prefHeight="90"
                        style="-fx-background-color: rgba(191,122,141,0.25); -fx-background-radius: 16;
                               -fx-border-color: rgba(191,122,141,0.7); -fx-border-radius: 16; -fx-border-width: 1.5;
                               -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(191,122,141,0.5), 16, 0, 0, 4);"
                        GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Button text="🎫  Abonamente" onAction="#deschideAbonamente"
                        prefWidth="200" prefHeight="90"
                        style="-fx-background-color: rgba(41,36,62,0.6); -fx-background-radius: 16;
                               -fx-border-color: rgba(123,76,197,0.6); -fx-border-radius: 16; -fx-border-width: 1.5;
                               -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(41,36,62,0.9), 16, 0, 0, 4);"
                        GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Button text="📊  Rapoarte" onAction="#deschideRapoarte"
                        prefWidth="200" prefHeight="90"
                        style="-fx-background-color: rgba(63,69,138,0.25); -fx-background-radius: 16;
                               -fx-border-color: rgba(191,122,141,0.55); -fx-border-radius: 16; -fx-border-width: 1.5;
                               -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(63,69,138,0.5), 16, 0, 0, 4);"
                        GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Button text="🔑  Utilizatori" onAction="#deschideUtilizatori"
                        prefWidth="200" prefHeight="90"
                        style="-fx-background-color: rgba(123,76,197,0.2); -fx-background-radius: 16;
                               -fx-border-color: rgba(191,122,141,0.5); -fx-border-radius: 16; -fx-border-width: 1.5;
                               -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(123,76,197,0.5), 16, 0, 0, 4);"
                        GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
        </VBox>
    </center>
</BorderPane>