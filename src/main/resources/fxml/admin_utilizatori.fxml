<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane style="-fx-background-color: #f0f4f8;" fx:controller="com.practica.controller.AdminUtilizatoriController">
<top>
<HBox style="-fx-background-color: #2c3e50; -fx-padding: 12 20;" alignment="CENTER_LEFT">
<Label text="🔑 Gestionare Utilizatori" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
</HBox>
</top>
<center>
<TableView fx:id="tableUtilizatori">
<columns>
<TableColumn fx:id="colId" text="ID" prefWidth="60"/>
<TableColumn fx:id="colUsername" text="Username" prefWidth="200"/>
<TableColumn fx:id="colRol" text="Rol" prefWidth="130"/>
<TableColumn fx:id="colIdMembru" text="ID Membru" prefWidth="110"/>
</columns>
<placeholder>
<Label text="Nu exista utilizatori." style="-fx-text-fill: #95a5a6;"/>
</placeholder>
</TableView>
</center>
<right>
<VBox spacing="10" style="-fx-padding: 20; -fx-background-color: white; -fx-min-width: 230; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, -2, 0);">
<Label text="Formular Utilizator" style="-fx-font-size: 15; -fx-font-weight: bold;"/>
<Label text="Username:"/>
<TextField fx:id="txtUsername" promptText="username"/>
<Label text="Parola:"/>
<PasswordField fx:id="txtParola"/>
<Label text="Rol:"/>
<ComboBox fx:id="comboRol" maxWidth="Infinity" promptText="Selecteaza rolul..."/>
<Label text="ID Membru (doar pt UTILIZATOR):"/>
<TextField fx:id="txtIdMembru" promptText="ex: 1001"/>
<Separator/>
<Button text="➕ Adauga" onAction="#handleAdauga" maxWidth="Infinity" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"/>
<Button text="🗑️ Sterge" onAction="#handleSterge" maxWidth="Infinity" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
<Separator/>
<Label text="ℹ️ Adminul nu are ID_Membru." style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;"/>
<Label text="Utilizatorul trebuie legat de un membru existent." style="-fx-text-fill: #7f8c8d; -fx-font-size: 11; -fx-wrap-text: true;"/>
</VBox>
</right>
</BorderPane>