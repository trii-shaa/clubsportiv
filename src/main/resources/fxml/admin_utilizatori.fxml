<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #f0f4f8;" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.practica.controller.AdminUtilizatoriController">
    <top>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 12 20;" alignment="CENTER_LEFT" spacing="15">
            <Label text="👥 Gestionare Membri" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <TextField fx:id="txtCautare" promptText="Cauta dupa nume..." prefWidth="200"/>
            <Button text="🔍 Cauta" onAction="#handleCautare" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 6 12;"/>
            <ComboBox fx:id="comboFiltruSectie" promptText="Filtreaza dupa sectie..." prefWidth="220" onAction="#handleFiltruSectie"/>
        </HBox>
    </top>
    
    <center>
        <TableView fx:id="tableMembri">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                <TableColumn fx:id="colNume" text="Nume" prefWidth="120"/>
                <TableColumn fx:id="colPrenume" text="Prenume" prefWidth="120"/>
                <TableColumn fx:id="colVarsta" text="Varsta" prefWidth="70"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
                <TableColumn fx:id="colTelefon" text="Telefon" prefWidth="120"/>
                <TableColumn fx:id="colSectie" text="ID Sectie" prefWidth="90"/>
                <TableColumn fx:id="colAbonament" text="ID Abonament" prefWidth="110"/>
            </columns>
            <placeholder>
                <Label text="Nu exista membri." style="-fx-text-fill: #95a5a6;"/>
            </placeholder>
        </TableView>
    </center>
    
    <right>
        <VBox spacing="8" style="-fx-padding: 20; -fx-background-color: white; -fx-min-width: 240; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, -2, 0);">
            <Label text="Formular Membru" style="-fx-font-size: 15; -fx-font-weight: bold;"/>
            <Label text="ID:"/>
            <TextField fx:id="txtId" promptText="ex: 1073"/>
            <Label text="Nume:"/>
            <TextField fx:id="txtNume"/>
            <Label text="Prenume:"/>
            <TextField fx:id="txtPrenume"/>
            <Label text="Varsta:"/>
            <TextField fx:id="txtVarsta"/>
            <Label text="Email:"/>
            <TextField fx:id="txtEmail"/>
            <Label text="Telefon:"/>
            <TextField fx:id="txtTelefon"/>
            <Label text="ID Antrenor (optional):"/>
            <TextField fx:id="txtIdAntrenor"/>
            <Label text="Sectie:"/>
            <ComboBox fx:id="comboSectie" maxWidth="Infinity" promptText="Selecteaza..."/>
            <Label text="Abonament:"/>
            <ComboBox fx:id="comboAbonament" maxWidth="Infinity" promptText="Selecteaza..."/>
            <Separator/>
            <Button text="➕ Adauga" onAction="#handleAdauga" maxWidth="Infinity" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Button text="✏️ Modifica" onAction="#handleModifica" maxWidth="Infinity" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Button text="🗑️ Sterge" onAction="#handleSterge" maxWidth="Infinity" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Button text="📥 Exporta" onAction="#handleExport" maxWidth="Infinity" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;"/>
        </VBox>
    </right>
</BorderPane>