<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #f0f4f8;" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.practica.controller.AbonamenteController">
    
    <top>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 12 20;" alignment="CENTER_LEFT" spacing="15">
            <Label text="💳 Gestionare Abonamente" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <TextField fx:id="txtCautare" promptText="Cauta dupa denumire..." prefWidth="200"/>
            <Button text="🔍 Cauta" onAction="#handleCautare" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 6 12;"/>
        </HBox>
    </top>
    
    <center>
        <TableView fx:id="tableAbonamente">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                <TableColumn fx:id="colDenumire" text="Denumire" prefWidth="150"/>
                <TableColumn fx:id="colDescriere" text="Descriere" prefWidth="220"/>
                <TableColumn fx:id="colDataInceput" text="Data Inceput" prefWidth="120"/>
                <TableColumn fx:id="colDataExpirarii" text="Data Expirarii" prefWidth="120"/>
                <TableColumn fx:id="colPret" text="Pret (MDL)" prefWidth="100"/>
            </columns>
            <placeholder>
                <Label text="Nu exista abonamente." style="-fx-text-fill: #95a5a6;"/>
            </placeholder>
        </TableView>
    </center>
    
    <right>
        <VBox spacing="8" style="-fx-padding: 20; -fx-background-color: white; -fx-min-width: 250; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, -2, 0);">
            <Label text="Formular Abonament" style="-fx-font-size: 15; -fx-font-weight: bold;"/>
            
            <Label text="ID:"/>
            <TextField fx:id="txtId" promptText="ex: 1"/>
            
            <Label text="Denumire:"/>
            <TextField fx:id="txtDenumire" promptText="ex: Premium"/>
            
            <Label text="Descriere:"/>
            <TextField fx:id="txtDescriere" promptText="ex: Acces complet sala/bazin"/>
            
            <Label text="Data Inceput:"/>
            <DatePicker fx:id="dpDataInceput" maxWidth="Infinity" promptText="Selecteaza data"/>
            
            <Label text="Data Expirarii:"/>
            <DatePicker fx:id="dpDataExpirarii" maxWidth="Infinity" promptText="Selecteaza data"/>
            
            <Label text="Pret:"/>
            <TextField fx:id="txtPret" promptText="ex: 600"/>
            
            <Separator style="-fx-padding: 5 0;"/>
            
            <Button text="➕ Adauga" onAction="#handleAdauga" maxWidth="Infinity" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Button text="✏️ Modifica" onAction="#handleModifica" maxWidth="Infinity" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Button text="🗑️ Sterge" onAction="#handleSterge" maxWidth="Infinity" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Button text="📥 Exporta" onAction="#handleExport" maxWidth="Infinity" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;"/>
        </VBox>
    </right>
</BorderPane>