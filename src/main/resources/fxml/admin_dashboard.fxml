<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane style="-fx-background-color: #f0f4f8;" fx:controller="com.practica.controller.MainController">
<top>
<HBox style="-fx-background-color: #2c3e50; -fx-padding: 14 20;" alignment="CENTER_LEFT" spacing="20">
<Label text="🏋️ Club Sportiv" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
<Label fx:id="lblWelcome" style="-fx-text-fill: #bdc3c7; -fx-font-size: 13;"/>
<HBox HBox.hgrow="ALWAYS"/>
<Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 6 14;"/>
</HBox>
</top>
<center>
<VBox spacing="20" alignment="CENTER" style="-fx-padding: 40;">
<Label text="Panou Administrator" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
<GridPane hgap="15" vgap="15" alignment="CENTER">
<Button text="👥 Membri" onAction="#deschideMembri" prefWidth="180" prefHeight="80" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 15; -fx-cursor: hand; -fx-background-radius: 8;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
<Button text="🏃 Antrenori" onAction="#deschideAntrenori" prefWidth="180" prefHeight="80" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 15; -fx-cursor: hand; -fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
<Button text="📅 Sedinte" onAction="#deschideSedinte" prefWidth="180" prefHeight="80" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 15; -fx-cursor: hand; -fx-background-radius: 8;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
<Button text="🎫 Abonamente" onAction="#deschideAbonamente" prefWidth="180" prefHeight="80" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 15; -fx-cursor: hand; -fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
<Button text="📊 Rapoarte" onAction="#deschideRapoarte" prefWidth="180" prefHeight="80" style="-fx-background-color: #1abc9c; -fx-text-fill: white; -fx-font-size: 15; -fx-cursor: hand; -fx-background-radius: 8;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
<Button text="🔑 Utilizatori" onAction="#deschideUtilizatori" prefWidth="180" prefHeight="80" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 15; -fx-cursor: hand; -fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
</GridPane>
</VBox>
</center>
</BorderPane>