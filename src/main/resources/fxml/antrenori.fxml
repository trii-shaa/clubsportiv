<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" style="-fx-background-color: #11121d;" fx:controller="com.practica.controller.AntrenoriController">
    <top>
        <HBox style="-fx-background-color: rgba(41,36,62,0.9);
                     -fx-border-color: rgba(123,76,197,0.3); -fx-border-width: 0 0 1 0;
                     -fx-padding: 12 24;"
              alignment="CENTER_LEFT" spacing="12">
            <Label text="Gestionare Antrenori"
                   style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtCautare" promptText="Cauta dupa nume..." prefWidth="200"
                       style="-fx-background-color: rgba(63,69,138,0.28); -fx-background-radius: 8;
                              -fx-border-color: rgba(123,76,197,0.4); -fx-border-radius: 8; -fx-border-width: 1;
                              -fx-text-fill: white; -fx-prompt-text-fill: rgba(201,194,224,0.4); -fx-padding: 7 12;"/>
            <Button text="🔍 Cauta" onAction="#handleCautare"
                    style="-fx-background-color: rgba(63,69,138,0.6); -fx-background-radius: 8;
                           -fx-border-color: rgba(63,69,138,0.9); -fx-border-radius: 8; -fx-border-width: 1;
                           -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 7 14;"/>
            <ComboBox fx:id="comboFiltruSectie" promptText="Filtreaza dupa sectie..." prefWidth="200"
                      onAction="#handleFiltruSectie"
                      style="-fx-background-color: rgba(41,36,62,0.7); -fx-background-radius: 8;
                             -fx-border-color: rgba(123,76,197,0.4); -fx-border-radius: 8; -fx-border-width: 1;"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tableAntrenori"
                   style="-fx-background-color: rgba(17,18,29,0.8);
                          -fx-border-color: rgba(63,69,138,0.3); -fx-border-width: 1 0 0 0;">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colNume" text="Nume" prefWidth="120"/>
                <TableColumn fx:id="colPrenume" text="Prenume" prefWidth="120"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
                <TableColumn fx:id="colTelefon" text="Telefon" prefWidth="120"/>
                <TableColumn fx:id="colSectie" text="Sectie" prefWidth="150"/>
                <TableColumn fx:id="colSalariu" text="Salariu (MDL)" prefWidth="120"/>
            </columns>
            <placeholder>
                <Label text="Nu exista antrenori." style="-fx-text-fill: rgba(191,122,141,0.6);"/>
            </placeholder>
        </TableView>
    </center>
    <right>
        <VBox spacing="8"
              style="-fx-background-color: rgba(41,36,62,0.72);
                     -fx-border-color: rgba(123,76,197,0.35); -fx-border-width: 0 0 0 1;
                     -fx-padding: 20; -fx-min-width: 250;
                     -fx-effect: dropshadow(gaussian, rgba(17,18,29,0.8), 24, 0, 0, 0);">
            <Label text="Formular Antrenor"
                   style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 0 0 6 0;"/>
            <Label text="ID:" style="-fx-text-fill: #c9c2e0; -fx-font-size: 11;"/>
            <TextField fx:id="txtId" promptText="ex: 51"
                       style="-fx-background-color: rgba(63,69,138,0.22); -fx-background-radius: 8;
                              -fx-border-color: rgba(123,76,197,0.35); -fx-border-radius: 8; -fx-border-width: 1;
                              -fx-text-fill: white; -fx-padding: 7 10;"/>
            <Label text="Nume:" style="-fx-text-fill: #c9c2e0; -fx-font-size: 11;"/>
            <TextField fx:id="txtNume" promptText="Nume"
                       style="-fx-background-color: rgba(63,69,138,0.22); -fx-background-radius: 8;
                              -fx-border-color: rgba(123,76,197,0.35); -fx-border-radius: 8; -fx-border-width: 1;
                              -fx-text-fill: white; -fx-padding: 7 10;"/>
            <Label text="Prenume:" style="-fx-text-fill: #c9c2e0; -fx-font-size: 11;"/>
            <TextField fx:id="txtPrenume" promptText="Prenume"
                       style="-fx-background-color: rgba(63,69,138,0.22); -fx-background-radius: 8;
                              -fx-border-color: rgba(123,76,197,0.35); -fx-border-radius: 8; -fx-border-width: 1;
                              -fx-text-fill: white; -fx-padding: 7 10;"/>
            <Label text="Email:" style="-fx-text-fill: #c9c2e0; -fx-font-size: 11;"/>
            <TextField fx:id="txtEmail" promptText="email@club.md"
                       style="-fx-background-color: rgba(63,69,138,0.22); -fx-background-radius: 8;
                              -fx-border-color: rgba(123,76,197,0.35); -fx-border-radius: 8; -fx-border-width: 1;
                              -fx-text-fill: white; -fx-padding: 7 10;"/>
            <Label text="Telefon:" style="-fx-text-fill: #c9c2e0; -fx-font-size: 11;"/>
            <TextField fx:id="txtTelefon" promptText="069xxxxxx"
                       style="-fx-background-color: rgba(63,69,138,0.22); -fx-background-radius: 8;
                              -fx-border-color: rgba(123,76,197,0.35); -fx-border-radius: 8; -fx-border-width: 1;
                              -fx-text-fill: white; -fx-padding: 7 10;"/>
            <Label text="Salariu (MDL):" style="-fx-text-fill: #c9c2e0; -fx-font-size: 11;"/>
            <TextField fx:id="txtSalariu" promptText="ex: 3000"
                       style="-fx-background-color: rgba(63,69,138,0.22); -fx-background-radius: 8;
                              -fx-border-color: rgba(123,76,197,0.35); -fx-border-radius: 8; -fx-border-width: 1;
                              -fx-text-fill: white; -fx-padding: 7 10;"/>
            <Label text="Sectie:" style="-fx-text-fill: #c9c2e0; -fx-font-size: 11;"/>
            <ComboBox fx:id="comboSectie" maxWidth="Infinity" promptText="Selecteaza sectia..."
                      style="-fx-background-color: rgba(41,36,62,0.7); -fx-background-radius: 8;
                             -fx-border-color: rgba(123,76,197,0.35); -fx-border-radius: 8; -fx-border-width: 1;"/>
            <Separator style="-fx-background-color: rgba(123,76,197,0.3);"/>
            <Button text="Adauga" onAction="#handleAdauga" maxWidth="Infinity"
                    style="-fx-background-color: rgba(63,138,100,0.35); -fx-background-radius: 8;
                           -fx-border-color: rgba(39,174,96,0.7); -fx-border-radius: 8; -fx-border-width: 1;
                           -fx-text-fill: #7dffb3; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8;"/>
            <Button text="Modifica" onAction="#handleModifica" maxWidth="Infinity"
                    style="-fx-background-color: rgba(191,122,141,0.22); -fx-background-radius: 8;
                           -fx-border-color: rgba(191,122,141,0.6); -fx-border-radius: 8; -fx-border-width: 1;
                           -fx-text-fill: #ffc4d3; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8;"/>
            <Button text="Sterge" onAction="#handleSterge" maxWidth="Infinity"
                    style="-fx-background-color: rgba(180,50,60,0.25); -fx-background-radius: 8;
                           -fx-border-color: rgba(231,76,60,0.6); -fx-border-radius: 8; -fx-border-width: 1;
                           -fx-text-fill: #ff9090; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8;"/>
            <Button text="Exporta" onAction="#handleExport" maxWidth="Infinity"
                    style="-fx-background-color: rgba(63,69,138,0.35); -fx-background-radius: 8;
                           -fx-border-color: rgba(63,69,138,0.8); -fx-border-radius: 8; -fx-border-width: 1;
                           -fx-text-fill: #b0b8ff; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8;"/>
        </VBox>
    </right>
</BorderPane>