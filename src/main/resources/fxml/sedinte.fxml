<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane style="-fx-background-color: #f0f4f8;" fx:controller="com.practica.controller.SedinteController">
<top>
<HBox style="-fx-background-color: #2c3e50; -fx-padding: 12 20;" alignment="CENTER_LEFT" spacing="15">
<Label text="📅 Gestionare Sedinte" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
<HBox HBox.hgrow="ALWAYS"/>
<Label text="Filtreaza dupa data:" style="-fx-text-fill: white;"/>
<DatePicker fx:id="dpFiltruData" promptText="Selecteaza data..." prefWidth="160"/>
<Button text="🔍 Filtreaza" onAction="#handleFiltruData" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 6 12;"/>
<Button text="↺ Reset" onAction="#handleResetFiltru" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 6 12;"/>
</HBox>
</top>
<center>
<TableView fx:id="tableSedinte">
<columns>
<TableColumn fx:id="colId" text="ID" prefWidth="60"/>
<TableColumn fx:id="colData" text="Data" prefWidth="130"/>
<TableColumn fx:id="colOra" text="Ora" prefWidth="100"/>
<TableColumn fx:id="colIdMembru" text="ID Membru" prefWidth="100"/>
<TableColumn fx:id="colIdAntrenor" text="ID Antrenor" prefWidth="100"/>
</columns>
<placeholder>
<Label text="Nu exista sedinte." style="-fx-text-fill: #95a5a6;"/>
</placeholder>
</TableView>
</center>
<right>
<VBox spacing="10" style="-fx-padding: 20; -fx-background-color: white; -fx-min-width: 230; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, -2, 0);">
<Label text="Formular Sedinta" style="-fx-font-size: 15; -fx-font-weight: bold;"/>
<Label text="ID:"/>
<TextField fx:id="txtId" promptText="ex: 51"/>
<Label text="Data:"/>
<DatePicker fx:id="dpData" maxWidth="Infinity"/>
<Label text="Ora (HH:MM:SS):"/>
<TextField fx:id="txtOra" promptText="ex: 09:00:00"/>
<Label text="ID Membru:"/>
<TextField fx:id="txtIdMembru" promptText="ex: 1001"/>
<Label text="ID Antrenor:"/>
<TextField fx:id="txtIdAntrenor" promptText="ex: 5"/>
<Separator/>
<Button text="➕ Adauga" onAction="#handleAdauga" maxWidth="Infinity" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"/>
<Button text="✏️ Modifica" onAction="#handleModifica" maxWidth="Infinity" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-cursor: hand;"/>
<Button text="🗑️ Sterge" onAction="#handleSterge" maxWidth="Infinity" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
<Button text="📥 Exporta" onAction="#handleExport" maxWidth="Infinity" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;"/>
</VBox>
</right>
</BorderPane>