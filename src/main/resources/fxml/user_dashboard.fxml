<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #11121d;"
            fx:controller="com.practica.controller.UserDashboardController">
    <stylesheets>
        <URL value="@/css/style.css"/>
    </stylesheets>

    <top>
        <HBox style="-fx-background-color: rgba(41,36,62,0.9);
                     -fx-border-color: rgba(123,76,197,0.3);
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 14 24;"
              alignment="CENTER_LEFT" spacing="16">
            <Label text="🏋️" style="-fx-font-size: 22;"/>
            <Label text="Club Sportiv"
                   style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="lblWelcome"
                   style="-fx-text-fill: rgba(191,122,141,0.85); -fx-font-size: 13;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: rgba(191,122,141,0.18);
                           -fx-background-radius: 8;
                           -fx-border-color: rgba(191,122,141,0.55);
                           -fx-border-radius: 8; -fx-border-width: 1;
                           -fx-text-fill: #bf7a8d; -fx-font-weight: bold;
                           -fx-cursor: hand; -fx-padding: 6 16;"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <Tab text="👤  Profilul meu">
                <ScrollPane fitToWidth="true"
                            style="-fx-background-color: #11121d; -fx-background: #11121d;">
                    <VBox spacing="16" style="-fx-padding: 28; -fx-background-color: #11121d;">

                        <Label text="Datele mele"
                               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>

                        <VBox style="-fx-background-color: rgba(41,36,62,0.72);
                                     -fx-border-color: rgba(123,76,197,0.35);
                                     -fx-border-width: 1; -fx-border-radius: 12;
                                     -fx-background-radius: 12; -fx-padding: 20;">
                            <GridPane hgap="24" vgap="12">
                                <Label text="Nume:" style="-fx-font-weight: bold; -fx-text-fill: #c9c2e0;"
                                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Label fx:id="lblNume" style="-fx-text-fill: white;"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="Prenume:" style="-fx-font-weight: bold; -fx-text-fill: #c9c2e0;"
                                       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Label fx:id="lblPrenume" style="-fx-text-fill: white;"
                                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="Varsta:" style="-fx-font-weight: bold; -fx-text-fill: #c9c2e0;"
                                       GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <Label fx:id="lblVarsta" style="-fx-text-fill: white;"
                                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                <Label text="Sectie:" style="-fx-font-weight: bold; -fx-text-fill: #c9c2e0;"
                                       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <Label fx:id="lblSectie" style="-fx-text-fill: white;"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                                <Label text="Abonament:" style="-fx-font-weight: bold; -fx-text-fill: #c9c2e0;"
                                       GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                <Label fx:id="lblAbonament" style="-fx-text-fill: white;"
                                       GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                                <Label text="Antrenor:" style="-fx-font-weight: bold; -fx-text-fill: #c9c2e0;"
                                       GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                                <Label fx:id="lblAntrenor" style="-fx-text-fill: white;"
                                       GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                            </GridPane>
                        </VBox>

                        <Separator style="-fx-background-color: rgba(123,76,197,0.3);"/>

                        <Label text="Modifica datele de contact"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: white;"/>

                        <VBox spacing="10"
                              style="-fx-background-color: rgba(41,36,62,0.72);
                                     -fx-border-color: rgba(123,76,197,0.35);
                                     -fx-border-width: 1; -fx-border-radius: 12;
                                     -fx-background-radius: 12; -fx-padding: 20;">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label text="Email:" style="-fx-font-weight: bold; -fx-text-fill: #c9c2e0;" prefWidth="80"/>
                                <TextField fx:id="txtEmail" prefWidth="300"
                                           style="-fx-background-color: rgba(63,69,138,0.22);
                                                  -fx-background-radius: 8;
                                                  -fx-border-color: rgba(123,76,197,0.35);
                                                  -fx-border-radius: 8; -fx-border-width: 1;
                                                  -fx-text-fill: white; -fx-padding: 7 10;"/>
                            </HBox>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label text="Telefon:" style="-fx-font-weight: bold; -fx-text-fill: #c9c2e0;" prefWidth="80"/>
                                <TextField fx:id="txtTelefon" prefWidth="300"
                                           style="-fx-background-color: rgba(63,69,138,0.22);
                                                  -fx-background-radius: 8;
                                                  -fx-border-color: rgba(123,76,197,0.35);
                                                  -fx-border-radius: 8; -fx-border-width: 1;
                                                  -fx-text-fill: white; -fx-padding: 7 10;"/>
                            </HBox>
                            <Button text="💾  Salveaza modificarile"
                                    onAction="#handleSalveazaDatePersonale"
                                    style="-fx-background-color: rgba(63,138,100,0.35);
                                           -fx-background-radius: 8;
                                           -fx-border-color: rgba(39,174,96,0.7);
                                           -fx-border-radius: 8; -fx-border-width: 1;
                                           -fx-text-fill: #7dffb3; -fx-font-weight: bold;
                                           -fx-cursor: hand; -fx-padding: 8 20;"/>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <Tab text="📅  Sedintele mele">
                <VBox spacing="14" style="-fx-padding: 24; -fx-background-color: #11121d;">
                    <Label text="Sedintele mele programate"
                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <TableView fx:id="tableSedinte" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: rgba(17,18,29,0.8);
                                      -fx-border-color: rgba(63,69,138,0.3);
                                      -fx-border-width: 1;">
                        <columns>
                            <TableColumn fx:id="colIdSedinta" text="ID"       prefWidth="60"/>
                            <TableColumn fx:id="colData"      text="Data"     prefWidth="130"/>
                            <TableColumn fx:id="colOra"       text="Ora"      prefWidth="100"/>
                            <TableColumn fx:id="colAntrenor"  text="Antrenor" prefWidth="200"/>
                        </columns>
                        <placeholder>
                            <Label text="Nu ai sedinte programate."
                                   style="-fx-text-fill: rgba(191,122,141,0.6);"/>
                        </placeholder>
                    </TableView>
                    <Button text="📥  Exporta sedintele mele" onAction="#handleExportSedinte"
                            style="-fx-background-color: rgba(63,69,138,0.35);
                                   -fx-background-radius: 8;
                                   -fx-border-color: rgba(63,69,138,0.8);
                                   -fx-border-radius: 8; -fx-border-width: 1;
                                   -fx-text-fill: #b0b8ff; -fx-font-weight: bold;
                                   -fx-cursor: hand; -fx-padding: 8 20;"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>