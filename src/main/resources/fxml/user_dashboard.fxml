<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #f0f4f8;" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.practica.controller.UserDashboardController">
    <top>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 14 20;" alignment="CENTER_LEFT" spacing="20">
            <Label text="Club Sportiv" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="lblWelcome" style="-fx-text-fill: #bdc3c7; -fx-font-size: 13;"/>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 6 14;"/>
        </HBox>
    </top>
    
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="👤 Profilul meu">
                <ScrollPane fitToWidth="true">
                    <VBox spacing="14" style="-fx-padding: 25;">
                        <Label text="Datele mele" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <GridPane hgap="20" vgap="10">
                            <Label text="Nume:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label fx:id="lblNume" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            
                            <Label text="Prenume:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Label fx:id="lblPrenume" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            
                            <Label text="Varsta:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label fx:id="lblVarsta" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            
                            <Label text="Sectie:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <Label fx:id="lblSectie" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                            
                            <Label text="Abonament:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                            <Label fx:id="lblAbonament" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                            
                            <Label text="Antrenor:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                            <Label fx:id="lblAntrenor" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                        </GridPane>
                        
                        <Separator/>
                        
                        <Label text="Modifica datele de contact" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Email:" style="-fx-font-weight: bold;" prefWidth="80"/>
                            <TextField fx:id="txtEmail" prefWidth="280"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Telefon:" style="-fx-font-weight: bold;" prefWidth="80"/>
                            <TextField fx:id="txtTelefon" prefWidth="280"/>
                        </HBox>
                        <Button text="💾 Salveaza modificarile" onAction="#handleSalveazaDatePersonale" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 20;"/>
                    </VBox>
                </ScrollPane>
            </Tab>
            
           <Tab text="📅 Sedintele mele">
    <HBox spacing="20" style="-fx-padding: 20;">
        <VBox spacing="12" HBox.hgrow="ALWAYS">
            <Label text="Sedintele mele programate" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TableView fx:id="tableSedinte">
                <columns>
                    <TableColumn fx:id="colId" text="ID" />
                    <TableColumn fx:id="colData" text="Data" />
                    <TableColumn fx:id="colOra" text="Ora" />
                    <TableColumn fx:id="colIdMembru" text="ID Membru" />
                    <TableColumn fx:id="colIdAntrenor" text="ID Antrenor" />
                </columns>
            </TableView>
            <Button text="📥 Exporta sedintele mele" onAction="#handleExportSedinte" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 20;"/>
        </VBox>

        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: white; -fx-min-width: 250; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
            <Label text="Programează o ședință" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Separator/>
            
            <Label text="ID Ședință nouă:"/>
            <TextField fx:id="txtNouIdSedinta" promptText="ex: 901"/>
            
            <Label text="Selectează Data:"/>
            <DatePicker fx:id="dpNouaData" maxWidth="Infinity"/>
            
            <Label text="Ora (HH:MM:SS):"/>
            <TextField fx:id="txtNouaOra" promptText="ex: 14:00:00"/>
            
            <Label text="ID Membru:"/>
            <TextField fx:id="txtIdMembru" promptText="Introduceți ID membru"/>

            <Label text="ID Antrenor:"/>
            <TextField fx:id="txtIdAntrenor" promptText="Introduceți ID antrenor"/>

            <Separator style="-fx-padding: 10 0 0 0;"/>
            <Button text="➕ Solicită Programare" onAction="#handleAdaugaSedinta" maxWidth="Infinity" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8;"/>
        </VBox>
    </HBox>
</Tab>
        </TabPane>
    </center>
</BorderPane>